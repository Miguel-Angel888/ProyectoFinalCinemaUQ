<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.proyectofinalcinemauq.controller.AdminController">

    <top>
        <HBox styleClass="barra">
            <Label text="CinemaUQ" styleClass="logo"/>
            <Label text="Panel del administrador" styleClass="titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="REPORTES Y GRÁFICOS" styleClass="boton-principal" onAction="#onReportes"/>
            <Label fx:id="lblAdmin"/>
            <Button text="Cerrar sesión" styleClass="boton-secundario" onAction="#onCerrarSesion"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <padding><Insets top="14" right="20" bottom="20" left="20"/></padding>

            <Tab text="Solicitudes de recarga">
                <VBox styleClass="panel">
                    <Label text="SOLICITUDES DE RECARGA PENDIENTES" styleClass="seccion"/>
                    <TableView fx:id="tablaSolicitudes" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colSolCliente" text="Cliente" prefWidth="200"/>
                            <TableColumn fx:id="colSolTarjeta" text="Tarjeta" prefWidth="120"/>
                            <TableColumn fx:id="colSolSaldo" text="Saldo actual" prefWidth="140"/>
                            <TableColumn fx:id="colSolMonto" text="Monto solicitado" prefWidth="150"/>
                            <TableColumn fx:id="colSolFecha" text="Fecha" prefWidth="160"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Rechazar" styleClass="boton-secundario" onAction="#onRechazar"/>
                        <Button text="APROBAR Y RECARGAR" styleClass="boton-principal" onAction="#onAprobar"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Clientes">
                <VBox styleClass="panel">
                    <Label text="CLIENTES" styleClass="seccion"/>
                    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCliNombre" text="Nombre" prefWidth="200"/>
                            <TableColumn fx:id="colCliCorreo" text="Correo" prefWidth="220"/>
                            <TableColumn fx:id="colCliTarjeta" text="Tarjeta" prefWidth="120"/>
                            <TableColumn fx:id="colCliSaldo" text="Saldo" prefWidth="140"/>
                            <TableColumn fx:id="colCliPuntos" text="Puntos vigentes" prefWidth="130"/>
                            <TableColumn fx:id="colCliCompras" text="Compras" prefWidth="90"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="Vales de confitería">
                <VBox styleClass="panel">
                    <Label text="VALES DE CONFITERÍA POR ENTREGAR" styleClass="seccion"/>
                    <TableView fx:id="tablaVales" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colValCliente" text="Cliente" prefWidth="200"/>
                            <TableColumn fx:id="colValCodigo" text="Código" prefWidth="140"/>
                            <TableColumn fx:id="colValRecompensa" text="Recompensa" prefWidth="240"/>
                            <TableColumn fx:id="colValFecha" text="Fecha del canje" prefWidth="160"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="MARCAR COMO ENTREGADO" styleClass="boton-principal" onAction="#onEntregarVale"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Funciones">
                <VBox styleClass="panel">
                    <Label text="FUNCIONES PROGRAMADAS" styleClass="seccion"/>
                    <Label styleClass="texto-suave"
                           text="Si el cine cancela una función, cada compra pagada se reembolsa al 100 % y el cliente recibe una notificación."/>
                    <TableView fx:id="tablaFunciones" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFunPelicula" text="Película" prefWidth="230"/>
                            <TableColumn fx:id="colFunSala" text="Sala" prefWidth="90"/>
                            <TableColumn fx:id="colFunFecha" text="Fecha" prefWidth="200"/>
                            <TableColumn fx:id="colFunOcupacion" text="Asientos ocupados" prefWidth="150"/>
                            <TableColumn fx:id="colFunCompras" text="Compras pagadas" prefWidth="140"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="CANCELAR FUNCIÓN Y REEMBOLSAR" styleClass="boton-principal" onAction="#onCancelarFuncion"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
